FROM docker.io/library/python:3.14.10-slim-trixie@sha256:9aaa474097d094040649f2162a627c0049b408f52138d980916788d80f04802f
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssh-client openssh-server \
       fontconfig fonts-dejavu-core libdbus-1-3 libegl1 libgl1 libglib2.0-0t64 libxkbcommon0 \
    && rm -rf /var/lib/apt/lists/*
COPY source-linux-x86_64-bootstrap.txt source-linux-x86_64.txt /locks/
COPY wheelhouse/ /wheelhouse/
RUN python -m venv /opt/editor \
    && /opt/editor/bin/python -m pip install --no-cache-dir --no-index --find-links /wheelhouse --require-hashes \
       --only-binary=:all: -r /locks/source-linux-x86_64-bootstrap.txt \
    && /opt/editor/bin/python -m pip install --no-cache-dir --no-index --find-links /wheelhouse --require-hashes \
       --no-build-isolation --only-binary=:all: --no-binary=pyftpdlib \
       -r /locks/source-linux-x86_64.txt
